{
  "name": "availity-starter-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "React project using @availity/workflow and TypeScript",
  "keywords": [
    "react",
    "availity",
    "workflow"
  ],
  "homepage": "https://github.com/availity/availity-workflow#readme",
  "license": "MIT",
  "main": "project/app/index.tsx",
  "scripts": {
    "av": "av",
    "about": "av about",
    "build": "av build",
    "build:production": "cross-env NODE_ENV=production av build",
    "build:staging": "cross-env NODE_ENV=staging av build",
    "help": "av help",
    "lint": "av lint",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,md,scss}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,md,scss}'",
    "production": "cross-env NODE_ENV=production av release",
    "profile": "av profile",
    "profile:production": "cross-env NODE_ENV=production av profile",
    "release": "av release",
    "staging": "cross-env NODE_ENV=staging av release",
    "start": "av start",
    "test": "av test",
    "test:coverage": "av test --coverage",
    "test:watch": "av test --watch",
    "typecheck": "tsc --noEmit",
    "upgrade:workflow": "./node_modules/.bin/upgrade-workflow"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "dependencies": {
    "@availity/api-axios": "^13.3.0",
    "@availity/element": "^3.0.4",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.75.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "^7.18.4",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@availity/mock-server": "^11.2.0",
    "@availity/workflow": "^14.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-availity": "^16.0.1",
    "prettier": "^3.9.7",
    "typescript": "6.0.3"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "packageManager": "yarn@4.17.0"
}
